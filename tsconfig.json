{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "@cloudflare/workers-types", "./src/*"],
    "exclude": ["dist"],
    "compilerOptions": {
      "jsx": "react-jsx",
      "jsxImportSource": "react",
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      }
    }
  }
  