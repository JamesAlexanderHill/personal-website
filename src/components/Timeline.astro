---

<section id="experience-and-education" class="scroll-mt-20 py-12">
  <h2 class="mb-8 text-2xl font-bold text-secondary">Experience & Education</h2>

  <div class="relative">
    <!-- Timeline line -->
    <div class="absolute left-6 top-0 h-full w-0.5 bg-secondary/20"></div>

    <div class="space-y-8">
      {
        items.map((item) => (
          <div class="relative pl-16">
            <!-- Timeline dot -->
            <div class="absolute left-4 flex h-5 w-5 items-center justify-center rounded-full border-2 border-accent bg-primary">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-3 w-3 text-accent"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                set:html={typeIcons[item.type]}
              />
            </div>

            <div class="rounded-lg border border-secondary/20 p-4 transition-colors hover:border-accent/50">
              <div class="mb-1 flex items-center justify-between">
                <h3 class="font-semibold text-secondary">{item.title}</h3>
                <span class="text-sm text-accent">{item.period}</span>
              </div>
              <p class="text-sm text-secondary/60">{item.organization}</p>
              {item.description && (
                <p class="mt-2 text-sm text-secondary/80">{item.description}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
