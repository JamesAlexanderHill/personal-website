---
interface TimelineItem {
  type: 'job' | 'education' | 'event';
  title: string;
  organization: string;
  period: string;
  description?: string;
  startDate: Date;
  endDate?: Date;
}

interface Props {
  items?: TimelineItem[];
}

const defaultItems: TimelineItem[] = [
  {
    type: 'job',
    title: 'Senior Web Engineer (Video)',
    organization: 'Foxtel Dazn',
    period: 'July 2025 - Present',
    startDate: new Date('2025-07-01'),
  },
  {
    type: 'event',
    title: 'Presentation on AI in Engineering',
    organization: '',
    period: '15th Sep 2025',
    startDate: new Date('2025-09-15'),
  },
  {
    type: 'event',
    title: 'Web Directions Engineering AI',
    organization: '',
    period: '12th Sep 2025',
    startDate: new Date('2025-09-12'),
  },
  {
    type: 'job',
    title: 'Web Engineer (Video)',
    organization: 'Foxtel Streamotion',
    period: 'Jan 2021 - July 2025',
    startDate: new Date('2021-01-01'),
    endDate: new Date('2025-07-01'),
  },
  {
    type: 'event',
    title: 'Presentation on ARIA Spec, accessibility and Lighthouse scores',
    organization: '',
    period: '9th Nov 2021',
    startDate: new Date('2021-11-09'),
  },
  {
    type: 'event',
    title: 'Web Direction AAA (All about access)',
    organization: '',
    period: '29th Oct 2021',
    startDate: new Date('2021-10-29'),
  },
  {
    type: 'job',
    title: 'Web Developer',
    organization: 'Cyrius Media Group',
    period: 'Mar 2019 - Jan 2021',
    startDate: new Date('2019-03-01'),
    endDate: new Date('2021-01-01'),
  },
  {
    type: 'education',
    title: 'Bachelor of Information Technology',
    organization: 'Macquarie University',
    period: 'Jan 2017 - Dec 2020',
    startDate: new Date('2017-01-01'),
    endDate: new Date('2020-12-01'),
  },
  {
    type: 'education',
    title: 'NSW High School Certificate',
    organization: 'St Joseph\'s College',
    period: 'Jan 2010 - Dec 2016',
    description: 'Completed Software Design and Development',
    startDate: new Date('2010-01-01'),
    endDate: new Date('2016-12-01'),
  },
];

const { items = defaultItems } = Astro.props;

// Sort items by start date (most recent first)
const sortedItems = [...items].sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

const typeIcons = {
  job: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  education: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
  event: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
};
---

<section id="experience-and-education" class="scroll-mt-20 py-12">
  <h2 class="mb-8 text-2xl font-bold text-secondary">Experience & Education</h2>

  <div class="relative">
    <!-- Timeline line -->
    <div class="absolute left-6 top-0 h-full w-0.5 bg-secondary/20"></div>

    <div class="space-y-8">
      {
        sortedItems.map((item) => (
          <div class="relative pl-16">
            <!-- Timeline dot -->
            <div class={`absolute left-4 flex h-5 w-5 items-center justify-center rounded-full border-2 ${
              item.type === 'event' ? 'border-purple-500 bg-purple-100' : 'border-accent bg-primary'
            }`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class={`h-3 w-3 ${item.type === 'event' ? 'text-purple-600' : 'text-accent'}`}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                set:html={typeIcons[item.type]}
              />
            </div>

            <div class={`rounded-lg border p-4 transition-colors ${
              item.type === 'event'
                ? 'border-purple-200 hover:border-purple-400 bg-purple-50/50'
                : 'border-secondary/20 hover:border-accent/50'
            }`}>
              <div class="mb-1 flex items-center justify-between">
                <h3 class="font-semibold text-secondary">{item.title}</h3>
                <span class={`text-sm ${item.type === 'event' ? 'text-purple-600' : 'text-accent'}`}>
                  {item.period}
                </span>
              </div>
              {item.organization && (
                <p class="text-sm text-secondary/60">{item.organization}</p>
              )}
              {item.description && (
                <p class="mt-2 text-sm text-secondary/80">{item.description}</p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
