---
import timelineData from '../data/timeline.json';

interface Period {
  id: string;
  type: 'work' | 'education' | 'volunteer' | 'project' | 'other';
  title: string;
  organisation: string;
  location?: string;
  startDate: string;
  endDate: string | null;
  blurb: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  logo?: string;
}

interface Event {
  id: string;
  type: 'conference' | 'presentation' | 'publication' | 'award' | 'milestone' | 'other';
  title: string;
  date: string;
  venue?: string;
  location?: string;
  blurb: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  icon?: string;
}

interface Props {
  ordering?: 'chronological' | 'reverse';
}

const { ordering = 'reverse' } = Astro.props;

const periods: Period[] = timelineData.periods;
const events: Event[] = timelineData.events;

// Helper functions
function getYear(dateStr: string | null): number {
  if (!dateStr) return new Date().getFullYear();
  return new Date(dateStr).getFullYear();
}

function getMonth(dateStr: string): number {
  return new Date(dateStr).getMonth(); // 0-11
}

const monthNames = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

// Calculate year range
const allYears = new Set<number>();
periods.forEach(period => {
  const startYear = getYear(period.startDate);
  const endYear = getYear(period.endDate);
  for (let year = startYear; year < endYear + 1; year++) {
    allYears.add(year);
  }
});
events.forEach(event => {
  allYears.add(getYear(event.date));
});

const sortedYears = Array.from(allYears).sort((a, b) =>
  ordering === 'chronological' ? a - b : b - a
);

// Build row structure for grid
interface TimelineRow {
  id: string;
  type: 'year' | 'month' | 'event';
  year: number;
  month?: number;
  event?: Event;
  rowNumber: number;
}

const rows: TimelineRow[] = [];
let currentRow = 1;

sortedYears.forEach(year => {
  // Year marker row
  rows.push({
    id: `timeline-${year}-yr-marker`,
    type: 'year',
    year,
    rowNumber: currentRow++
  });

  // Month rows + event rows
  for (let month = 0; month < 12; month++) {
    // Month row
    rows.push({
      id: `timeline-${year}-${monthNames[month]}-month`,
      type: 'month',
      year,
      month,
      rowNumber: currentRow++
    });

    // Event rows for this month
    const monthEvents = events.filter(e => {
      const eventYear = getYear(e.date);
      const eventMonth = getMonth(e.date);
      return eventYear === year && eventMonth === month;
    }).sort((a, b) => {
      const dateCompare = new Date(a.date).getTime() - new Date(b.date).getTime();
      if (dateCompare !== 0) return ordering === 'chronological' ? dateCompare : -dateCompare;
      return a.title.localeCompare(b.title);
    });

    monthEvents.forEach(event => {
      rows.push({
        id: `timeline-${year}-${monthNames[month]}-${event.id}`,
        type: 'event',
        year,
        month,
        event,
        rowNumber: currentRow++
      });
    });
  }
});

// Calculate period row spans
interface PeriodSpan {
  period: Period;
  startRow: number;
  endRow: number;
  lane: number;
}

function calculatePeriodSpans(): PeriodSpan[] {
  const spans: PeriodSpan[] = [];

  periods.forEach(period => {
    const startYear = getYear(period.startDate);
    const startMonth = getMonth(period.startDate);
    const endYear = getYear(period.endDate);
    const endMonth = getMonth(period.endDate);

    // Find start row (first month row >= period start)
    const startRow = rows.find(r =>
      r.type === 'month' &&
      (r.year > startYear || (r.year === startYear && r.month! >= startMonth))
    )?.rowNumber || 1;

    // Find end row (last row <= period end)
    let endRow = rows.length;
    for (let i = rows.length - 1; i >= 0; i--) {
      const r = rows[i];
      if (r.type === 'month' &&
          (r.year < endYear || (r.year === endYear && r.month! <= endMonth))) {
        endRow = r.rowNumber;
        break;
      }
    }

    spans.push({ period, startRow, endRow, lane: 0 });
  });

  // Sort by start date
  spans.sort((a, b) => {
    const dateA = new Date(a.period.startDate).getTime();
    const dateB = new Date(b.period.startDate).getTime();
    return ordering === 'chronological' ? dateA - dateB : dateB - dateA;
  });

  // Greedy lane assignment
  const laneEnds: number[] = [];
  spans.forEach(span => {
    let assignedLane = 0;
    for (let lane = 0; lane < laneEnds.length; lane++) {
      if (laneEnds[lane] < span.startRow) {
        assignedLane = lane;
        break;
      }
    }
    if (assignedLane === laneEnds.length) {
      laneEnds.push(0);
    }
    span.lane = assignedLane;
    laneEnds[assignedLane] = span.endRow;
  });

  return spans;
}

const periodSpans = calculatePeriodSpans();
const maxLanes = Math.max(...periodSpans.map(s => s.lane), 0) + 1;

// Type icons and labels
const periodIcons = {
  work: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  education: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />`,
  volunteer: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  project: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  other: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
};

const eventIcons = {
  conference: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  presentation: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />`,
  publication: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  award: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />`,
  milestone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`,
  other: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
};

const periodLabels = {
  work: 'Employment',
  education: 'Education',
  volunteer: 'Volunteer',
  project: 'Project',
  other: 'Other',
};

const eventLabels = {
  conference: 'Conference',
  presentation: 'Presentation',
  publication: 'Publication',
  award: 'Award',
  milestone: 'Milestone',
  other: 'Event',
};
---

<section id="timeline" class="scroll-mt-20 py-12" aria-label="Professional timeline">
  <h2 class="mb-8 text-2xl font-bold text-secondary">Experience & Education</h2>

  <!-- Desktop Layout -->
  <div class="hidden md:block">
    <div class="timeline-grid" style={`
      display: grid;
      grid-template-columns: repeat(${maxLanes}, 1fr) auto 1fr;
      grid-template-rows: repeat(${rows.length}, auto);
      gap: 0;
      position: relative;
    `}>
      <!-- Timeline rail (center column) -->
      <div class="timeline-rail" style={`
        grid-column: ${maxLanes + 1};
        grid-row: 1 / -1;
        position: relative;
      `}>
        <div class="absolute inset-0 flex justify-center">
          <div class="w-0.5 bg-accent/30"></div>
        </div>
      </div>

      <!-- Render rows -->
      {rows.map((row) => {
        if (row.type === 'year') {
          return (
            <div
              id={row.id}
              class="year-marker"
              style={`
                grid-column: ${maxLanes + 1};
                grid-row: ${row.rowNumber};
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 1rem 0;
                z-index: 10;
              `}
            >
              <div class="px-3 py-1 bg-primary">
                <span class="text-xs font-medium text-secondary/70">{row.year}</span>
              </div>
            </div>
          );
        }

        if (row.type === 'event' && row.event) {
          const event = row.event;
          return (
            <>
              <!-- Event dot on timeline -->
              <div
                id={row.id}
                class="event-dot"
                style={`
                  grid-column: ${maxLanes + 1};
                  grid-row: ${row.rowNumber};
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  padding: 0.5rem 0;
                  z-index: 5;
                `}
              >
                <div class="h-3 w-3 rounded-full bg-accent border-2 border-primary"></div>
              </div>

              <!-- Event card (right column) -->
              <div
                id={`event-${row.year}-${monthNames[row.month!]}-${event.id}`}
                class="event-card"
                style={`
                  grid-column: ${maxLanes + 2};
                  grid-row: ${row.rowNumber};
                  padding: 0.5rem 0 0.5rem 1rem;
                `}
                tabindex="0"
                role="article"
                aria-labelledby={`event-title-${event.id}`}
              >
                <div class="relative">
                  <!-- Arrow connector -->
                  <svg class="absolute right-full top-4 mr-1" width="16" height="2">
                    <line x1="0" y1="1" x2="16" y2="1" stroke="currentColor" stroke-width="1" class="text-accent/50" />
                  </svg>

                  <div class="rounded-lg border border-secondary/20 bg-primary p-4 transition-all hover:border-accent hover:shadow-lg">
                    <div class="flex items-start gap-3">
                      <div class="flex-shrink-0 h-8 w-8 rounded-full border border-accent/50 bg-accent/10 flex items-center justify-center">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 text-accent"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          set:html={eventIcons[event.type]}
                          aria-hidden="true"
                        />
                      </div>
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2 mb-1">
                          <span class="text-xs font-medium text-accent uppercase tracking-wide">
                            {eventLabels[event.type]}
                          </span>
                          <time datetime={event.date} class="text-xs text-secondary/60 whitespace-nowrap">
                            {new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                          </time>
                        </div>
                        <h3 id={`event-title-${event.id}`} class="font-semibold text-secondary mb-1">
                          {event.title}
                        </h3>
                        <p class="text-sm text-secondary/80 leading-relaxed">{event.blurb}</p>
                        {event.tags && event.tags.length > 0 && (
                          <div class="flex flex-wrap gap-2 mt-3">
                            {event.tags.map(tag => (
                              <span class="text-xs px-2 py-1 rounded bg-accent/10 text-accent border border-accent/20">
                                {tag}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </>
          );
        }

        return null;
      })}

      <!-- Render periods with sticky spans -->
      {periodSpans.map((span) => {
        const period = span.period;
        const isCurrent = period.endDate === null;

        return (
          <div
            id={`period-${period.id}`}
            class="period-wrapper"
            style={`
              grid-column: ${span.lane + 1};
              grid-row: ${span.startRow} / ${span.endRow + 1};
              position: relative;
              padding-right: 1rem;
            `}
          >
            <!-- Gradient from timeline -->
            <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-r from-accent/5 to-transparent pointer-events-none"></div>

            <div class="sticky top-24 period-card-container">
              <div
                class="period-card group rounded-lg border border-secondary/20 bg-primary p-4 transition-all hover:border-accent hover:shadow-lg hover:scale-[1.02] focus-within:border-accent focus-within:shadow-lg focus-within:scale-[1.02]"
                tabindex="0"
                role="article"
                aria-labelledby={`period-title-${period.id}`}
              >
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full border border-accent/50 bg-accent/10 flex items-center justify-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 text-accent"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      set:html={periodIcons[period.type]}
                      aria-hidden="true"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between gap-2 mb-1">
                      <span class="text-xs font-medium text-accent uppercase tracking-wide">
                        {periodLabels[period.type]}
                      </span>
                      <span class="text-xs text-secondary/60 whitespace-nowrap">
                        {new Date(period.startDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                        {' - '}
                        {isCurrent ? 'Present' : new Date(period.endDate!).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                      </span>
                    </div>
                    <h3 id={`period-title-${period.id}`} class="font-semibold text-secondary mb-1 text-lg">
                      {period.title}
                    </h3>
                    <p class="text-sm text-secondary/70 mb-2">{period.organisation}</p>
                    {period.location && (
                      <p class="text-xs text-secondary/50 mb-2">{period.location}</p>
                    )}
                    <p class="text-sm text-secondary/80 leading-relaxed">{period.blurb}</p>
                    {period.tags && period.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2 mt-3">
                        {period.tags.map(tag => (
                          <span class="text-xs px-2 py-1 rounded bg-accent/10 text-accent border border-accent/20">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Mobile Layout -->
  <div class="md:hidden">
    <div class="relative grid grid-cols-[auto_1fr] gap-4">
      <!-- Timeline rail (left) -->
      <div class="relative">
        <div class="absolute left-3 top-0 bottom-0 w-0.5 bg-accent/30"></div>

        {rows.map((row) => {
          if (row.type === 'year') {
            return (
              <div id={row.id} class="relative py-4 flex justify-center">
                <div class="px-2 py-0.5 bg-primary">
                  <span class="text-xs font-medium text-secondary/70">{row.year.toString().slice(2)}</span>
                </div>
              </div>
            );
          }

          if (row.type === 'event' && row.event) {
            return (
              <button
                id={row.id}
                class="mobile-event-marker relative py-2 flex justify-center"
                data-event-id={row.event.id}
                aria-label={`${row.event.title} on ${new Date(row.event.date).toLocaleDateString()}`}
              >
                <div class="h-3 w-3 rounded-full bg-accent border-2 border-primary"></div>
              </button>
            );
          }

          return <div class="py-1"></div>;
        })}
      </div>

      <!-- Periods (right) -->
      <div class="space-y-4 pt-4">
        {periodSpans.map((span) => {
          const period = span.period;
          return (
            <div
              id={`period-${period.id}-mobile`}
              class="rounded-lg border border-secondary/20 bg-primary p-3"
            >
              <div class="flex items-center gap-2 mb-2">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  set:html={periodIcons[period.type]}
                />
                <span class="text-xs font-medium text-accent uppercase">
                  {periodLabels[period.type]}
                </span>
              </div>
              <h4 class="font-semibold text-secondary mb-1">{period.title}</h4>
              <p class="text-sm text-secondary/70 mb-2">{period.organisation}</p>
              <p class="text-sm text-secondary/80">{period.blurb}</p>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- Mobile Event Modal -->
<div id="event-modal" class="md:hidden fixed inset-0 bg-primary/95 backdrop-blur-sm z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="min-h-screen px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <button
        id="close-modal"
        class="mb-4 flex items-center gap-2 text-secondary/70 hover:text-accent transition-colors"
        aria-label="Close modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Close</span>
      </button>
      <div id="modal-content"></div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .period-card,
    .event-card,
    .mobile-event-marker {
      transition: none;
    }
  }

  .period-card:hover,
  .period-card:focus {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .period-card:hover,
    .period-card:focus {
      transform: none;
    }
  }

  .mobile-event-marker {
    cursor: pointer;
    transition: transform 0.2s;
  }

  .mobile-event-marker:hover {
    transform: scale(1.2);
  }
</style>

<script>
  // Mobile event modal functionality
  const modal = document.getElementById('event-modal');
  const modalContent = document.getElementById('modal-content');
  const closeBtn = document.getElementById('close-modal');

  let scrollPosition = 0;
  let focusedElement: HTMLElement | null = null;

  document.querySelectorAll('.mobile-event-marker').forEach(button => {
    button.addEventListener('click', (e) => {
      const eventId = (e.currentTarget as HTMLElement).dataset.eventId;
      const eventEl = document.querySelector(`[id*="event-"][id*="${eventId}"]`);

      if (eventEl && modal && modalContent) {
        focusedElement = e.currentTarget as HTMLElement;
        scrollPosition = window.scrollY;
        modalContent.innerHTML = eventEl.innerHTML;
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Focus close button
        closeBtn?.focus();
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      window.scrollTo(0, scrollPosition);

      // Return focus
      if (focusedElement) {
        focusedElement.focus();
        focusedElement = null;
      }
    }
  }

  closeBtn?.addEventListener('click', closeModal);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Trap focus in modal
  modal?.addEventListener('keydown', (e) => {
    if (e.key === 'Tab' && !modal.classList.contains('hidden')) {
      const focusableElements = modal.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const firstElement = focusableElements[0] as HTMLElement;
      const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;

      if (e.shiftKey && document.activeElement === firstElement) {
        e.preventDefault();
        lastElement.focus();
      } else if (!e.shiftKey && document.activeElement === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
    }
  });
</script>
