---
interface TimelineItem {
  type: 'education' | 'employment' | 'notable-event';
  subtype?: 'conference' | 'presentation';
  title: string;
  organization?: string;
  period: string;
  summary?: string;
  startDate: Date;
  endDate?: Date;
}

interface Props {
  items?: TimelineItem[];
}

const defaultItems: TimelineItem[] = [
  {
    type: 'employment',
    title: 'Senior Web Engineer (Video)',
    organization: 'Foxtel Dazn',
    period: 'July 2025 - Present',
    summary: 'Leading video engineering initiatives and architecting scalable streaming solutions.',
    startDate: new Date('2025-07-01'),
  },
  {
    type: 'notable-event',
    subtype: 'presentation',
    title: 'Presentation on AI in Engineering',
    period: '15th Sep 2025',
    summary: 'Presented insights on integrating AI tools into engineering workflows.',
    startDate: new Date('2025-09-15'),
  },
  {
    type: 'notable-event',
    subtype: 'conference',
    title: 'Web Directions Engineering AI',
    period: '12th Sep 2025',
    summary: 'Attended conference focused on AI in web engineering.',
    startDate: new Date('2025-09-12'),
  },
  {
    type: 'employment',
    title: 'Web Engineer (Video)',
    organization: 'Foxtel Streamotion',
    period: 'Jan 2021 - July 2025',
    summary: 'Built and maintained video streaming applications, improving performance and accessibility.',
    startDate: new Date('2021-01-01'),
    endDate: new Date('2025-07-01'),
  },
  {
    type: 'notable-event',
    subtype: 'presentation',
    title: 'Presentation on ARIA Spec, accessibility and Lighthouse scores',
    period: '9th Nov 2021',
    summary: 'Presented on web accessibility standards and performance optimization.',
    startDate: new Date('2021-11-09'),
  },
  {
    type: 'notable-event',
    subtype: 'conference',
    title: 'Web Direction AAA (All about access)',
    period: '29th Oct 2021',
    summary: 'Attended accessibility-focused conference.',
    startDate: new Date('2021-10-29'),
  },
  {
    type: 'employment',
    title: 'Web Developer',
    organization: 'Cyrius Media Group',
    period: 'Mar 2019 - Jan 2021',
    summary: 'Developed responsive websites and web applications for diverse clients.',
    startDate: new Date('2019-03-01'),
    endDate: new Date('2021-01-01'),
  },
  {
    type: 'education',
    title: 'Bachelor of Information Technology',
    organization: 'Macquarie University',
    period: 'Jan 2017 - Dec 2020',
    summary: 'Focused on software engineering, web development, and distributed systems.',
    startDate: new Date('2017-01-01'),
    endDate: new Date('2020-12-01'),
  },
  {
    type: 'education',
    title: 'NSW High School Certificate',
    organization: 'St Joseph\'s College',
    period: 'Jan 2010 - Dec 2016',
    summary: 'Completed Software Design and Development.',
    startDate: new Date('2010-01-01'),
    endDate: new Date('2016-12-01'),
  },
];

const { items = defaultItems } = Astro.props;

// Sort items by start date (most recent first)
const sortedItems = [...items].sort((a, b) => b.startDate.getTime() - a.startDate.getTime());

// Separate periods (left side) and events (right side)
const periods = sortedItems.filter(item => item.type === 'education' || item.type === 'employment');
const events = sortedItems.filter(item => item.type === 'notable-event');

const typeConfig = {
  education: {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />`,
    label: 'Education',
  },
  employment: {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
    label: 'Employment',
  },
  conference: {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
    label: 'Conference',
  },
  presentation: {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />`,
    label: 'Presentation',
  },
};

function getTypeConfig(item: TimelineItem) {
  if (item.type === 'notable-event' && item.subtype) {
    return typeConfig[item.subtype];
  }
  return typeConfig[item.type];
}
---

<section id="experience-and-education" class="scroll-mt-20 py-12">
  <h2 class="mb-8 text-2xl font-bold text-secondary">Experience & Education</h2>

  <div class="relative">
    <!-- Timeline structure -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] gap-8 md:gap-12 relative">
      <!-- Left side: Periods (Education & Employment) with sticky positioning -->
      <div class="space-y-0">
        {
          periods.map((item, index) => {
            const config = getTypeConfig(item);
            return (
              <div key={index} class="relative">
                <div class="sticky top-20 z-10 border-y border-t-secondary/10 border-b-secondary/20 bg-primary/95 backdrop-blur-sm px-4 py-3 mb-4">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <div class="flex h-6 w-6 items-center justify-center rounded-full border border-accent/50 bg-accent/10">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-3 w-3 text-accent"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          set:html={config.icon}
                        />
                      </div>
                      <span class="text-xs font-semibold text-accent uppercase tracking-wide">
                        {config.label}
                      </span>
                    </div>
                    <span class="text-xs text-secondary/70 font-medium whitespace-nowrap">{item.period}</span>
                  </div>
                </div>

                <div class="px-4 pb-6">
                  <div class="rounded-lg border border-secondary/20 bg-primary p-4 transition-all hover:border-accent/50 hover:shadow-lg">
                    <h3 class="font-semibold text-secondary mb-1 text-lg">{item.title}</h3>
                    {item.organization && (
                      <p class="text-sm text-secondary/70 mb-3">{item.organization}</p>
                    )}
                    {item.summary && (
                      <p class="text-sm text-secondary/60 leading-relaxed">{item.summary}</p>
                    )}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Center: Timeline line (hidden on mobile) -->
      <div class="hidden md:block relative w-px">
        <div class="sticky top-20 h-screen w-0.5 bg-gradient-to-b from-accent/50 via-accent/30 to-transparent mx-auto"></div>
      </div>

      <!-- Right side: Notable Events -->
      <div class="space-y-6">
        {
          events.map((item, index) => {
            const config = getTypeConfig(item);
            return (
              <div key={index} class="relative">
                <div class="rounded-lg border border-secondary/20 bg-primary p-4 transition-all hover:border-accent/50 hover:shadow-lg">
                  <div class="mb-2 flex items-start justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <div class="flex h-8 w-8 items-center justify-center rounded-full border border-accent/50 bg-accent/10">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 text-accent"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          set:html={config.icon}
                        />
                      </div>
                      <span class="text-xs font-medium text-accent uppercase tracking-wide">
                        {config.label}
                      </span>
                    </div>
                    <span class="text-xs text-secondary/60 whitespace-nowrap">{item.period}</span>
                  </div>
                  <h3 class="font-semibold text-secondary mb-1">{item.title}</h3>
                  {item.organization && (
                    <p class="text-sm text-secondary/70 mb-2">{item.organization}</p>
                  )}
                  {item.summary && (
                    <p class="text-sm text-secondary/60 leading-relaxed">{item.summary}</p>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Smooth scroll behavior for the timeline */
  #experience-and-education {
    scroll-behavior: smooth;
  }
</style>
