---
import timelineData from './timeline.json';

interface Period {
  id: string;
  type: string;
  title: string;
  organisation: string;
  location?: string;
  startDate: string;
  endDate: string | null;
  blurb: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  logo?: string;
}

interface Event {
  id: string;
  type: string;
  title: string;
  date: string;
  venue?: string;
  location?: string;
  blurb: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  icon?: string;
}

interface Props {
  ordering?: 'chronological' | 'reverse';
}

const { ordering = 'reverse' } = Astro.props;

const periods: Period[] = timelineData.periods;
const events: Event[] = timelineData.events;

// Get all years from events and periods
function getYearList(events: Event[], periods: Period[]): number[] {
  const eventYears = events.map(event => new Date(event.date).getFullYear());
  const periodYears = periods.flatMap(period => [
    new Date(period.startDate).getFullYear(),
    new Date(period.endDate ?? new Date()).getFullYear()
  ]);

  const yearSet = new Set([...eventYears, ...periodYears]);
  const yearList = Array.from(yearSet).sort((a, b) => a - b);

  const minYear = yearList[0] ?? new Date().getFullYear();
  const maxYear = yearList[yearList.length - 1] ?? new Date().getFullYear();
  const range = maxYear - minYear;

  // Create continuous range of years
  const allYears = Array.from({ length: range + 1 }, (_, i) => minYear + i);

  return ordering === 'chronological' ? allYears : allYears.reverse();
}

const years = getYearList(events, periods);

// Filter events by year
function filterEventsByYear(events: Event[], year: number): Event[] {
  return events.filter(event => new Date(event.date).getFullYear() === year);
}

// Type icons
const eventIcons = {
  conference: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  presentation: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />`,
  publication: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  award: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />`,
  milestone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />`,
  other: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
};

const eventLabels = {
  conference: 'Conference',
  presentation: 'Presentation',
  publication: 'Publication',
  award: 'Award',
  milestone: 'Milestone',
  other: 'Event',
};

const periodIcons = {
  work: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  education: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />`,
  volunteer: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  project: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  other: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
};

const periodLabels = {
  work: 'Employment',
  education: 'Education',
  volunteer: 'Volunteer',
  project: 'Project',
  other: 'Other',
};
---

<section id="timeline" class="scroll-mt-20 py-12 relative" aria-label="Professional timeline">
  <h2 class="mb-8 text-2xl font-bold text-secondary">Experience & Education</h2>

  <!-- Desktop/Mobile Layout -->
  <div class="relative" id="timeline-container" data-ordering={ordering}>
    <!-- Timeline rail (vertical line) -->
    <div class="absolute top-0 -z-10 border-accent border-l-2 min-h-[100px] h-full" style="left: var(--x-offset);"></div>

    <!-- Period cards (absolutely positioned, heights calculated from DOM) -->
    {periods.map(period => {
      const startYear = new Date(period.startDate).getFullYear();
      const endYear = period.endDate ? new Date(period.endDate).getFullYear() : null;

      return (
        <div
          class="period-card absolute hidden sm:block w-64 opacity-0 transition-all duration-300 hover:z-20 focus-within:z-20"
          data-period-id={period.id}
          data-start-year={startYear}
          data-end-year={endYear}
          data-is-current={endYear === null ? 'true' : 'false'}
          style="right: calc(50% + 3rem); z-index: 10;"
          tabindex="0"
          role="article"
          aria-label={`${period.title} at ${period.organisation}`}
        >
          <!-- Card border and background (full height) -->
          <div class="h-full border-2 border-accent/30 hover:border-accent rounded-md bg-primary/50 backdrop-blur-sm transition-colors relative overflow-hidden">
            <!-- Gradient pointing toward timeline -->
            <div class="absolute inset-y-0 -right-12 w-12 bg-gradient-to-r from-accent/10 to-transparent pointer-events-none"></div>

            <!-- Sticky content wrapper -->
            <div class="sticky top-0 max-h-full p-3 overflow-auto period-card-content">
              <div class="relative z-10">
                <div class="flex items-start gap-3 mb-2">
                  <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary border-2 border-accent flex items-center justify-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-accent"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      set:html={periodIcons[period.type]}
                      aria-hidden="true"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <span class="text-xs font-medium text-accent uppercase tracking-wide block mb-1">
                      {periodLabels[period.type]}
                    </span>
                    <h3 class="font-semibold text-secondary text-sm leading-tight">
                      {period.title}
                    </h3>
                    <p class="text-xs text-secondary/70 mt-0.5">
                      {period.organisation}
                    </p>
                  </div>
                </div>

                <div class="text-xs text-secondary/60 mb-2">
                  {new Date(period.startDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  {' - '}
                  {period.endDate
                    ? new Date(period.endDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
                    : 'Present'
                  }
                </div>

                <!-- Scrollable blurb section -->
                <div class="period-blurb max-h-32 overflow-y-auto mb-2">
                  <p class="text-xs text-secondary/80 leading-relaxed">
                    {period.blurb}
                  </p>
                </div>

                {period.tags && period.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1">
                    {period.tags.slice(0, 3).map(tag => (
                      <span class="text-xs px-1.5 py-0.5 rounded bg-accent/10 text-accent border border-accent/20">
                        {tag}
                      </span>
                    ))}
                    {period.tags.length > 3 && (
                      <span class="text-xs px-1.5 py-0.5 text-secondary/60">
                        +{period.tags.length - 3}
                      </span>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })}

    <!-- Gradient fade at top -->
    <div class="h-4 bg-gradient-to-t from-transparent to-primary"></div>

    <!-- Events and year markers -->
    {years.map(year => {
      const yearEvents = filterEventsByYear(events, year);

      return (
        <>
          {yearEvents.length > 0 ? (
            yearEvents.map(event => (
              <div class="flex gap-x-2 my-2 -translate-x-8 group" style="margin-left: var(--x-offset);">
                <!-- Icon/dot (clickable on mobile) -->
                <div class="w-16 flex-shrink-0">
                  <button
                    class="mobile-event-icon sm:pointer-events-none flex-shrink-0 h-8 w-8 rounded-full bg-primary border-2 translate-x-[1px] border-accent flex items-center justify-center mx-auto transition-transform hover:scale-110 sm:hover:scale-100"
                    data-event-id={event.id}
                    aria-label={`View ${event.title}`}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 text-accent"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      set:html={eventIcons[event.type]}
                      aria-hidden="true"
                    />
                  </button>
                </div>

                <!-- Event content -->
                <div class="grow max-w-md mr-4 hidden sm:block" data-event-content={event.id}>
                  <div class="border-2 border-accent/30 group-hover:border-accent p-2 rounded-md transition-colors">
                    <div class="flex items-start gap-3">
                      <div class="flex-1 min-w-0">
                        <div class="flex items-start justify-between gap-2 mb-1">
                          <span class="text-xs font-medium text-accent uppercase tracking-wide">
                            {eventLabels[event.type]}
                          </span>
                          <time datetime={event.date} class="text-xs text-secondary/60 whitespace-nowrap">
                            {new Date(event.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                          </time>
                        </div>
                        <h3 class="font-semibold text-secondary mb-1">
                          {event.title}
                        </h3>
                        <p class="text-sm text-secondary/80 leading-relaxed">
                          {event.blurb}
                        </p>
                        {event.tags && event.tags.length > 0 && (
                          <div class="flex flex-wrap gap-2 mt-3">
                            {event.tags.map(tag => (
                              <span class="text-xs px-2 py-1 rounded bg-accent/10 text-accent border border-accent/20">
                                {tag}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="h-2"></div>
          )}

          <!-- Year marker -->
          <p class="-translate-x-8 w-16 text-xs text-secondary/70 flex justify-center items-center bg-primary rounded-full my-3 py-1 year-marker after:bg-accent-color after:content-['']
         after:absolute
         after:block
         after:bottom-0
         after:left-1/2
         after:translate-x-[-2px]
         after:translate-y-1/2
         after:w-[6px]
         after:h-[6px]
         after:rounded-full
         after:bg-accent" data-year={year} style="margin-left: var(--x-offset);">
            {year}
          </p>
        </>
      );
    })}

    <!-- Gradient fade at bottom -->
    <div class="h-4 bg-gradient-to-b from-transparent to-primary"></div>
  </div>
</section>

<!-- Mobile Event Modal -->
<div id="event-modal" class="sm:hidden fixed inset-0 bg-primary/95 backdrop-blur-sm z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="min-h-screen px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <button
        id="close-modal"
        class="mb-4 flex items-center gap-2 text-secondary/70 hover:text-accent transition-colors"
        aria-label="Close modal"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span>Close</span>
      </button>
      <div id="modal-content"></div>
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .border-accent,
    .mobile-event-icon,
    .period-card {
      transition: none;
    }
  }

  #timeline {
    --x-offset: 2rem;
  }

  @media (width > 40rem) {
    #timeline {
      --x-offset: 50%;
    }

    /* Position period cards to the left of center timeline on desktop */
    .period-card {
      right: calc(50% + 3rem) !important;
    }
  }

  /* Ensure period cards don't overflow on smaller screens */
  @media (width <= 40rem) {
    .period-card {
      display: none;
    }
  }

  /* Custom scrollbar for period blurb */
  .period-blurb::-webkit-scrollbar {
    width: 4px;
  }

  .period-blurb::-webkit-scrollbar-track {
    background: rgb(251 146 60 / 0.1);
    border-radius: 2px;
  }

  .period-blurb::-webkit-scrollbar-thumb {
    background: rgb(251 146 60 / 0.3);
    border-radius: 2px;
  }

  .period-blurb::-webkit-scrollbar-thumb:hover {
    background: rgb(251 146 60 / 0.5);
  }

  /* Firefox scrollbar */
  .period-blurb {
    scrollbar-width: thin;
    scrollbar-color: rgb(251 146 60 / 0.3) rgb(251 146 60 / 0.1);
  }

  /* Focus outline for period cards */
  .period-card:focus {
    outline: 2px solid rgb(251 146 60 / 0.5);
    outline-offset: 2px;
  }
</style>

<script>
  // Mobile event modal functionality
  const modal = document.getElementById('event-modal');
  const modalContent = document.getElementById('modal-content');
  const closeBtn = document.getElementById('close-modal');

  let scrollPosition = 0;
  let focusedElement: HTMLElement | null = null;

  // Add click handlers to mobile event icons
  document.querySelectorAll('.mobile-event-icon').forEach(button => {
    button.addEventListener('click', (e) => {
      e.preventDefault();
      const eventId = (e.currentTarget as HTMLElement).dataset.eventId;

      // Find the event content
      const eventContent = document.querySelector(`[data-event-content="${eventId}"]`);

      if (eventContent && modal && modalContent) {
        focusedElement = e.currentTarget as HTMLElement;
        scrollPosition = window.scrollY;

        // Clone the content into the modal
        modalContent.innerHTML = eventContent.innerHTML;

        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Focus close button
        closeBtn?.focus();
      }
    });
  });

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      window.scrollTo(0, scrollPosition);

      // Return focus
      if (focusedElement) {
        focusedElement.focus();
        focusedElement = null;
      }
    }
  }

  closeBtn?.addEventListener('click', closeModal);

  // Close on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Trap focus in modal
  modal?.addEventListener('keydown', (e) => {
    if (e.key === 'Tab' && !modal.classList.contains('hidden')) {
      const focusableElements = modal.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      const firstElement = focusableElements[0] as HTMLElement;
      const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;

      if (e.shiftKey && document.activeElement === firstElement) {
        e.preventDefault();
        lastElement.focus();
      } else if (!e.shiftKey && document.activeElement === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
    }
  });

  // Position period cards based on DOM year markers
  function positionPeriodCards() {
    const container = document.getElementById('timeline-container');
    if (!container) return;

    const containerTop = container.offsetTop;
    const ordering = container.dataset.ordering || 'reverse';
    const allYearMarkers = Array.from(document.querySelectorAll('.year-marker')) as HTMLElement[];

    document.querySelectorAll('.period-card').forEach(card => {
      const element = card as HTMLElement;
      const startYear = element.dataset.startYear;
      const endYear = element.dataset.endYear;
      const isCurrent = element.dataset.isCurrent === 'true';

      if (!startYear) return;

      // Find year marker for start year
      const startMarker = document.querySelector(`.year-marker[data-year="${startYear}"]`) as HTMLElement;
      if (!startMarker) return;

      let endMarker: HTMLElement | null = null;

      // Handle null end date (current/ongoing period)
      if (isCurrent || endYear === 'null' || !endYear) {
        // If ordering is 'reverse' (newest first), extend to top of timeline (first marker)
        // If ordering is 'chronological' (oldest first), extend to bottom of timeline (last marker)
        if (ordering === 'reverse') {
          endMarker = allYearMarkers[0]; // First marker (most recent year)
        } else {
          endMarker = allYearMarkers[allYearMarkers.length - 1]; // Last marker (most recent year)
        }
      } else {
        // Find year marker for end year
        endMarker = document.querySelector(`.year-marker[data-year="${endYear}"]`) as HTMLElement;
      }

      if (startMarker && endMarker) {
        // Calculate positions relative to container
        const startY = startMarker.offsetTop - containerTop;
        const endY = endMarker.offsetTop - containerTop + endMarker.offsetHeight;

        // Set position and height
        element.style.top = `${startY}px`;
        element.style.height = `${endY - startY}px`;

        // Fade in the card
        element.style.opacity = '1';
      }
    });
  }

  // Run positioning on load and resize
  if (typeof window !== 'undefined') {
    window.addEventListener('load', positionPeriodCards);
    window.addEventListener('resize', positionPeriodCards);

    // Also run after a short delay to ensure DOM is fully rendered
    setTimeout(positionPeriodCards, 100);
  }
</script>
