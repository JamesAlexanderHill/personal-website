---
import type { Event } from "./types";
import { eventIcons } from "./icons";

interface Props {
  event: Event;
}

const { event } = Astro.props;
const date = new Date(event.date);
---

<article
  class="timeline-marker event-marker relative
  min-h-[4rem] ml-(--x-offset) mr-10 py-2"
  data-date-ms={date.getTime()}
>
  <button
    class="mobile-event-icon peer absolute left-0 -translate-x-1/2 p-2
    border-2 border-accent rounded-full bg-primary text-accent
    sm:pointer-events-none cursor-pointer sm:cursor-auto"
    data-event-id={event.id}
    aria-label={`View ${event.title}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      set:html={eventIcons[event.type]}
      aria-hidden="true"
    />
  </button>
  <div
    class="peer ml-10 hidden sm:block
    border-2 border-accent/30 hover:border-accent peer-hover:border-accent
    rounded-md bg-primary/50 backdrop-blur-sm transition-colors"
    data-event-content={event.id}
  >
    <div class="w-full max-w-md p-3">
      <div class="flex items-start justify-between gap-2 mb-1">
        <span class="text-xs font-medium text-accent uppercase tracking-wide">
          {event.type}
        </span>
        <time datetime={event.date} class="text-xs text-secondary/60 whitespace-nowrap">
          {new Date(event.date).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
        </time>
      </div>
      <h3 class="font-semibold text-secondary mb-1">{event.title}</h3>
      {(event.venue || event.location) && (
        <p class="text-xs text-secondary/60 mb-1">
          {event.venue && <span>{event.venue}</span>}
          {event.venue && event.location && <span> • </span>}
          {event.location && <span>{event.location}</span>}
        </p>
      )}
      <p class="text-sm text-secondary/80 leading-relaxed">{event.blurb}</p>
      {event.links && event.links.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {event.links.map((link) => (
            <a href={link.url} class="text-xs text-accent hover:text-accent/80 underline" target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          ))}
        </div>
      )}
      {event.tags && event.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-3">
          {event.tags.map((tag) => (
            <span class="text-xs px-2 py-1 rounded bg-accent/10 text-accent border border-accent/20">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
  <div
    class="hidden sm:block -z-5 border-t-2 border-accent/20 w-10 absolute top-7 peer-hover:border-accent"
  >
  </div>
</article>
