---
import type { Event } from "./types";
import { eventIcons } from "./icons";

interface Props {
  event: Event;
}

const { event } = Astro.props;
const date = new Date(event.date);
---

<article
  class="timeline-marker event-marker relative
  min-h-[4rem] ml-(--x-offset) mr-10 py-2"
  data-date-ms={date.getTime()}
>
  <button
    class="peer absolute left-0 -translate-x-1/2 p-2
    border-2 border-accent rounded-full bg-primary text-accent
    sm:pointer-events-none cursor-pointer sm:cursor-auto"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-5 w-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      set:html={eventIcons[event.type]}
      aria-hidden="true"
    />
  </button>
  <div
    class="peer ml-10 hidden sm:block
    border-2 border-accent/30 hover:border-accent peer-hover:border-accent
    rounded-md bg-primary/50 backdrop-blur-sm transition-colors"
  >
    <div class="w-full max-w-md">content</div>
  </div>
  <div
    class="hidden sm:block -z-5 border-t-2 border-accent/20 w-10 absolute top-7 peer-hover:border-accent"
  >
  </div>
</article>
