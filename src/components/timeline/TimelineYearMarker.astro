---
interface Props {
  date: Date;
}

const { date } = Astro.props;
const year = date.getFullYear();
---

<p
  class="timeline-marker year-marker
  -translate-x-6 w-12 ml-(--x-offset)
  text-xs text-secondary/70 flex justify-center items-center bg-primary rounded-full my-3 py-1
  after:content-[''] after:absolute after:block after:bottom-0 after:left-1/2 after:translate-x-[-2px] after:translate-y-1/2 after:w-[6px] after:h-[6px] after:rounded-full after:bg-accent"
  data-date-ms={date.getTime()}
>
  {year}
</p>
