---
import type { Period } from './types';
import { periodIcons, periodLabels } from './icons';

interface Props {
  period: Period;
}

const { period } = Astro.props;
const startYear = new Date(period.startDate).getFullYear();
const endYear = period.endDate ? new Date(period.endDate).getFullYear() : new Date().getFullYear();
---

<div
  class="period-card absolute hidden sm:block w-64 opacity-0 transition-opacity duration-300"
  data-period-id={period.id}
  data-start-year={startYear}
  data-end-year={endYear}
  style="right: calc(50% + 3rem);"
>
  <div class="h-full border-2 border-accent/30 hover:border-accent rounded-md p-3 bg-primary/50 backdrop-blur-sm transition-colors relative overflow-hidden">
    <!-- Gradient pointing toward timeline -->
    <div class="absolute inset-y-0 -right-12 w-12 bg-gradient-to-r from-accent/10 to-transparent pointer-events-none"></div>

    <div class="relative z-10">
      <div class="flex items-start gap-3 mb-2">
        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-primary border-2 border-accent flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 text-accent"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            set:html={periodIcons[period.type]}
            aria-hidden="true"
          />
        </div>
        <div class="flex-1 min-w-0">
          <span class="text-xs font-medium text-accent uppercase tracking-wide block mb-1">
            {periodLabels[period.type]}
          </span>
          <h3 class="font-semibold text-secondary text-sm leading-tight">
            {period.title}
          </h3>
          <p class="text-xs text-secondary/70 mt-0.5">
            {period.organisation}
          </p>
        </div>
      </div>

      <div class="text-xs text-secondary/60 mb-2">
        {new Date(period.startDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
        {' - '}
        {period.endDate
          ? new Date(period.endDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
          : 'Present'
        }
      </div>

      <p class="text-xs text-secondary/80 leading-relaxed mb-2">
        {period.blurb}
      </p>

      {period.tags && period.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {period.tags.slice(0, 3).map(tag => (
            <span class="text-xs px-1.5 py-0.5 rounded bg-accent/10 text-accent border border-accent/20">
              {tag}
            </span>
          ))}
          {period.tags.length > 3 && (
            <span class="text-xs px-1.5 py-0.5 text-secondary/60">
              +{period.tags.length - 3}
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</div>
